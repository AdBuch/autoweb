# Server (loopback only by default — do not expose publicly without auth)
PORT=4173
HOST=127.0.0.1

# AI agent provider: mistral | openai (chatgpt) | anthropic (claude) | gemini | ollama
# If unset, the first provider with an API key below is used; otherwise mock mode.
PROVIDER=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# GitHub connection: the app must run inside a git clone of the repo, and
# `git push` from that clone must work (e.g. `gh auth login` or stored credentials).
GITHUB_REPO=
# optional; defaults to the origin remote (e.g. AdBuch/autoweb)
SITE_BRANCH=
# empty = repo default branch
GITHUB_PUSH=true
# set to false to update the site locally without pushing
